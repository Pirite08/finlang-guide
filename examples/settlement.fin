// 소수 자릿수 0을 지정하면 원 단위처럼 정수 자리까지 남깁니다.
// HALF_EVEN은 정확히 중간인 2.5에서 짝수 쪽인 2를 고릅니다.
print(round(2.5, 0, "HALF_EVEN"));
// HALF_UP은 정확히 중간일 때 절댓값이 커지는 쪽을 고릅니다.
print(round(2.5, 0, "HALF_UP"));
// settle로 Money를 정산하면 통화는 그대로 유지됩니다.
print(settle(money("KRW", 2.5), 0, "HALF_UP"));
// 나눗셈도 결과 자릿수와 반올림 방식을 지정합니다.
print(div(1, 3, 4, "HALF_EVEN"));
